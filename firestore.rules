rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dome collection rules
    match /domes/{domeId} {
      // Anyone can read public domes
      allow read: if resource.data.isPublic == true;

      // Authenticated users can read their own domes
      allow read: if request.auth != null &&
                     request.auth.uid == resource.data.ownerId;

      // Authenticated users can create domes
      allow create: if request.auth != null &&
                      request.auth.uid == request.resource.data.ownerId &&
                      request.resource.data.ownerEmail == request.auth.token.email &&
                      // Schema validation - require core fields (excluding timestamps which are server-generated)
                      request.resource.data.isPublic is bool &&
                      request.resource.data.keys().hasAll(['id', 'name', 'ownerId', 'ownerEmail', 'faceData', 'isPublic']) &&
                      // Optional fork tracking fields must be both present or both absent
                      (!request.resource.data.keys().hasAny(['forkedFromDomeId']) ||
                       request.resource.data.keys().hasAll(['forkedFromDomeId', 'forkedFromOwnerId']));

      // Users can update their own domes (but cannot change ownership)
      allow update: if request.auth != null &&
                      request.auth.uid == resource.data.ownerId &&
                      // SECURITY: Prevent changing ownership or email
                      request.resource.data.ownerId == resource.data.ownerId &&
                      request.resource.data.ownerEmail == resource.data.ownerEmail &&
                      // Schema validation for updates
                      request.resource.data.isPublic is bool;

      // Users can delete their own domes
      allow delete: if request.auth != null &&
                      request.auth.uid == resource.data.ownerId;
    }
  }
}
