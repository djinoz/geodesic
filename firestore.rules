rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dome collection rules
    match /domes/{domeId} {
      // Allow reading if doc doesn't exist (to check existence) or if public/owned
      allow read: if resource == null ||
                     resource.data.isPublic == true ||
                     (request.auth != null && request.auth.uid == resource.data.ownerId);

      // Authenticated users can create domes
      allow create: if request.auth != null &&
                      request.auth.uid == request.resource.data.ownerId &&

                      // SECURITY: Ensure email matches auth token
                      request.resource.data.ownerEmail == request.auth.token.email &&
                      // Schema validation
                      request.resource.data.keys().hasAll(['id', 'name', 'ownerId', 'ownerEmail', 'faceData', 'isPublic']) &&
                      request.resource.data.name is string &&
                      request.resource.data.faceData is map &&
                      request.resource.data.isPublic is bool;

      // Users can update their own domes (but cannot change ownership)
      allow update: if request.auth != null &&
                      request.auth.uid == resource.data.ownerId &&
                      // SECURITY: Prevent changing ownership or email
                      request.resource.data.ownerId == resource.data.ownerId &&
                      request.resource.data.ownerEmail == resource.data.ownerEmail &&
                      // Schema validation for updates
                      request.resource.data.isPublic is bool;

      // Users can delete their own domes
      allow delete: if request.auth != null &&
                      request.auth.uid == resource.data.ownerId;
    }

    // Progress collection rules
    // Document ID format: {userId}_{domeId}
    match /progress/{progressId} {
      // Users can only read their own progress documents
      allow read: if request.auth != null &&
                    resource.data.userId == request.auth.uid;

      // Users can create their own progress documents
      allow create: if request.auth != null &&
                      request.resource.data.userId == request.auth.uid &&
                      // Schema validation
                      request.resource.data.keys().hasAll(['id', 'userId', 'domeId', 'faceProgress', 'createdAt', 'updatedAt']) &&
                      request.resource.data.userId is string &&
                      request.resource.data.domeId is string &&
                      request.resource.data.faceProgress is map;

      // Users can update their own progress (but cannot change userId or domeId)
      allow update: if request.auth != null &&
                      resource.data.userId == request.auth.uid &&
                      // Prevent changing ownership
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.domeId == resource.data.domeId;

      // Users can delete their own progress
      allow delete: if request.auth != null &&
                      resource.data.userId == request.auth.uid;
    }
  }
}
